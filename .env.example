# =============================================================================
# SISYS 应用配置样例（根样例——技术债清偿 D15/4-6）
# =============================================================================
# 用途：本地开发环境应用配置样例（键清单 = 全仓 os.getenv 全量收录）
# 使用：复制为 .env 并按环境修改；组件级部署样例另见 deploy/*/.env.example
# 默认值口径：与各 from_env() 字面默认一致；数据源适配器的 URL/超时/TTL 类
#   键默认值定义于 src/infrastructure/config/datasources*.py（此处留空提示）
# =============================================================================

# ---------------------------------------------------------------------------
# 认证与安全（src/infrastructure/config/security.py / auth.py / password.py）
# ---------------------------------------------------------------------------
# 生产环境必须设置强密钥（无默认——缺失时 auth 模块拒绝启动）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_UPPERCASE=true

# ---------------------------------------------------------------------------
# PostgreSQL（L2 关系存储）
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=sisys
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30.0
POSTGRES_POOL_RECYCLE=3600
POSTGRES_ECHO=false

# ---------------------------------------------------------------------------
# Redis（L1 缓存 / realtime 事件通道）
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_DEFAULT_TTL=86400

# ---------------------------------------------------------------------------
# RabbitMQ（reliable 事件通道）
# ---------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=sisys.events.reliable
RABBITMQ_PREFETCH=10
RABBITMQ_HEARTBEAT=60

# ---------------------------------------------------------------------------
# MinIO（L4 对象存储）
# ---------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_SECURE=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_PREFIX=sisys
MINIO_CONNECT_TIMEOUT=5.0
MINIO_READ_TIMEOUT=30.0

# ---------------------------------------------------------------------------
# Qdrant（L3 向量存储）
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_HTTPS=false
QDRANT_API_KEY=
QDRANT_TIMEOUT=30.0
QDRANT_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Neo4j（L5 图存储）
# ---------------------------------------------------------------------------
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=50
NEO4J_MAX_RETRY_TIME=30.0
NEO4J_CONNECT_TIMEOUT=30.0

# ---------------------------------------------------------------------------
# LLM / 嵌入 / 重排（src/infrastructure/config/llm*.py / embedding*.py / reranker*.py）
# ---------------------------------------------------------------------------
LLM_MODEL=qwen2.5:7b
LLM_API_TYPE=openai
LLM_ENDPOINT=
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=
LLM_TIMEOUT=600.0
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_DEVICE=cuda
EMBEDDING_MODEL_PATH=
EMBEDDING_API_URL=
EMBEDDING_API_TIMEOUT=30.0
RERANKER_ENABLED=true
RERANKER_BASE_URL=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_TOP_K=20
RERANKER_TIMEOUT=10

# ---------------------------------------------------------------------------
# 编排引擎（LangGraph / Prefect）
# ---------------------------------------------------------------------------
LANGGRAPH_API_URL=http://localhost:8000
LANGGRAPH_CHECKPOINT_TABLE=langgraph_checkpoints
PREFECT_API_URL=http://localhost:4200/api
PREFECT_WORK_POOL_NAME=sisys-worker-pool

# ---------------------------------------------------------------------------
# 沙箱与工具执行（src/infrastructure/config/sandbox.py / tool_execution*.py / tool_version.py）
# ---------------------------------------------------------------------------
SANDBOX_TYPE=docker
SANDBOX_MAX_CONCURRENT_CONTAINERS=50
SANDBOX_IDLE_TIMEOUT_MINUTES=30
RESOURCE_LIMITS={}
EXECUTE_ENABLED=true
TRIGGER_ENABLED=true
TRIGGER_MAX_RETRIES=3
ROUTE_ENABLED=true
ROUTE_TYPE=mixed
TOOL_VERSION_MAX_RETAINED=10
SNAPSHOT_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# 文档理解（UDMR / RapidOCR / 爬虫 / 元数据校验）
# ---------------------------------------------------------------------------
UDMR_ENABLED=true
UDMR_LOCAL_FIRST=false
UDMR_LOCAL_MODEL=qwen2.5:7b
UDMR_LLM_TIMEOUT=600
UDMR_HEALTHCHECK_INTERVAL=300
RAPIDOCR_MODEL_DIR=
RAPIDOCR_MAX_CONCURRENCY=1
CRAWLER_SERVICE_URL=http://localhost:8900
METADATA_VALIDATION_MODE=
SEMANTIC_THRESHOLD=0.7

# ---------------------------------------------------------------------------
# 数据源适配器（URL/超时/TTL 默认值见 src/infrastructure/config/datasources*.py；
# API_KEY 类生产环境按需配置）
# ---------------------------------------------------------------------------
CHINA_NBS_BASE_URL=
CHINA_NBS_DOMAIN=
CHINA_NBS_POLL_INTERVAL_SEC=
CHINA_NBS_POLL_TIMEOUT_SEC=
CHINA_NBS_TTL_SECONDS=
COMTRADE_API_URL=
COMTRADE_API_KEY=
COMTRADE_TIMEOUT=
COMTRADE_TTL_SECONDS=
EPO_OPS_API_URL=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
EPO_OPS_TIMEOUT=
EPO_OPS_TTL_SECONDS=
EUROSTAT_API_URL=
EUROSTAT_TIMEOUT=
EUROSTAT_TTL_SECONDS=
GOOGLE_PATENTS_API_URL=
GOOGLE_PATENTS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PATENTS_TIMEOUT=
GOOGLE_PATENTS_TTL_SECONDS=
IMF_API_URL=
IMF_TIMEOUT=
IMF_TTL_SECONDS=
IPCC_CSV_BASE_URL=
IPCC_MAX_BYTES=
IPCC_TIMEOUT=
IPCC_TTL_SECONDS=
NEWSAPI_API_URL=
NEWSAPI_API_KEY=
NEWSAPI_TIMEOUT=
NEWSAPI_TTL_SECONDS=
SEC_EDGAR_API_URL=
SEC_EDGAR_TIMEOUT=
SEC_EDGAR_TTL_SECONDS=
TAVILY_API_URL=
TAVILY_API_KEY=
TAVILY_TIMEOUT=
TAVILY_TTL_SECONDS=
USPTO_API_URL=
USPTO_API_KEY=
USPTO_TIMEOUT=
USPTO_TTL_SECONDS=
WORLDBANK_API_URL=
WORLDBANK_TIMEOUT=
WORLDBANK_TTL_SECONDS=

# ---------------------------------------------------------------------------
# 可观测性（OTEL / Metrics）
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=sisys-event-bus
OTEL_DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER_ARG=0.1
EVENT_BUS_OTEL_TRACE_ENABLED=false
METRICS_ENABLED=false
METRICS_PATH=/metrics
METRICS_PORT=8080
METRICS_AUTH_ENABLED=false

# ---------------------------------------------------------------------------
# 其他（一致性哈希 / 心跳）
# ---------------------------------------------------------------------------
HASH_RING_SIZE=150
HEARTBEAT_INTERVAL_SECONDS=60

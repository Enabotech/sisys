# sisys - Environment Variables Template
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ===========================================
# Application Settings
# ===========================================
APP_NAME=sisys
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# ===========================================
# Database - PostgreSQL (L2 Storage)
# ===========================================
POSTGRES_USER=sisys_dev
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=sisys
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sisys_dev:your_secure_password_here@localhost:5432/sisys

# ===========================================
# Cache - Redis (L1 Storage)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ===========================================
# Vector Database - Qdrant (L3 Storage)
# ===========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_HTTPS=false
QDRANT_TIMEOUT=30.0
QDRANT_MAX_RETRIES=3

# ===========================================
# Object Storage - MinIO (L4 Storage)
# ===========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sisys_minio_admin
MINIO_SECRET_KEY=your_secure_minio_password_here
MINIO_BUCKET=sisys-documents
MINIO_URL=http://localhost:9000

# ===========================================
# Graph Database - Neo4j (L5 Storage)
# ===========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_DATABASE=neo4j

# ===========================================
# Security & Authentication
# ===========================================
SECRET_KEY=your_super_secret_key_for_jwt_signing_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# LLM & AI Settings
# ===========================================
# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b

# Cloud LLM (Optional - for fallback)
CLOUD_LLM_PROVIDER=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_MODEL_PATH=/mnt/x/.cache/BAAI/bge-m3/
EMBEDDING_MODEL_DEVICE=cuda

# ===========================================
# Message Queue - RabbitMQ
# ===========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=sisys
RABBITMQ_PASSWORD=your_secure_rabbitmq_password_here
RABBITMQ_VHOST=/

# ===========================================
# Monitoring & Observability
# ===========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# ===========================================
# Feature Flags
# ===========================================
ENABLE_SEMANTIC_CACHE=true
ENABLE_UDMR=true
ENABLE_EIP=true
ENABLE_CHECKPOINT=true

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# File Upload Limits
# ===========================================
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_FILE_EXTENSIONS=pdf,txt,doc,docx,ppt,pptx,xls,xlsx,csv,jpeg,png,gif,md,html,zip,tar

# ===========================================
# Harbor Registry (for CI/CD Pipeline)
# ===========================================
# Harbor 管理员凭据（用于本地测试）
# 注意：实际值应从 Gitea 仓库密钥获取
HARBOR_USERNAME=admin
HARBOR_PASSWORD=your_harbor_admin_password_here

# Harbor 机器人账户（用于 CI/CD Pipeline 推送/拉取）
HARBOR_ROBOT_USERNAME=robot$sisys+gitea-runner-push
HARBOR_ROBOT_PASSWORD=your_harbor_robot_password_here

# Harbor CA 证书路径（用于 Docker 信任）
HARBOR_CA_CRT_PATH=/etc/docker/certs.d/harbor.sisys.local/ca.crt

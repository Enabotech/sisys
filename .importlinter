[importlinter]
root_package = src
include_external_packages = True

# P0-05 Fix: Use independence constraint instead of whitelist forbidden list.
# This ensures domain layer cannot import ANY external package, not just the
# ones we happened to list.
[importlinter:contract:domain-independent-layer]
name = Domain layer must be independent from all other layers
type = independence
modules =
    src.domain
    src.application
    src.interfaces
    src.infrastructure

[importlinter:contract:dependency-direction]
name = Dependency direction must follow hexagonal architecture
type = layers
layers =
    src.interfaces
    src.application
    src.domain

[importlinter:contract:infrastructure-does-not-depend-on-interfaces]
name = Infrastructure layer must not depend on interfaces layer
type = forbidden
source_modules =
    src.infrastructure
forbidden_modules =
    src.interfaces

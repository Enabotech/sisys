# SISYS 环境配置模板
# 此文件由安装程序复制并在安装时生成随机密码

# 应用端口
SISYS_PORT=8080

# 数据库配置（安装时生成随机密码） # pragma: allowlist secret
POSTGRES_PASSWORD=__POSTGRES_PASSWORD_PLACEHOLDER__

# MinIO 配置（安装时生成随机密码）
MINIO_USER=sisys_admin
# pragma: allowlist secret
MINIO_PASSWORD=__MINIO_PASSWORD_PLACEHOLDER__

# Docker 镜像源（可选，默认 docker.io）
DOCKER_REGISTRY=docker.io
APP_VERSION=latest

# 数据路径（安装时替换为实际路径）
SISYS_DATA=__SISYS_DATA_PATH__
SISYS_LOGS=__SISYS_LOGS_PATH__

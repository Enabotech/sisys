# =============================================================================
# SISYS 六层存储 - 统一环境变量配置
# =============================================================================
# 用途：本地开发和生产环境统一配置
# Story: 1.4-1.8 (六层存储架构)
# 使用：复制为 .env 并根据环境修改
# =============================================================================

# ---------------------------------------------------------------------------
# 通用配置
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=sisys
HARBOR_REGISTRY=harbor.sisys.local

# ---------------------------------------------------------------------------
# L1: Redis 配置
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-secure-password-here
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=86400
REDIS_BLACKBOARD_TTL=604800

# ---------------------------------------------------------------------------
# L2: PostgreSQL 配置
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=sisys
POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30.0
POSTGRES_POOL_RECYCLE=3600
POSTGRES_ECHO=false
# POSTGRES_APP_PASSWORD=strong-app-password
# POSTGRES_READER_PASSWORD=strong-reader-password

# ---------------------------------------------------------------------------
# L3: Qdrant 配置
# ---------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=your-secure-api-key-here
QDRANT_HTTPS=false
QDRANT_TIMEOUT=30.0
QDRANT_MAX_RETRIES=3
QDRANT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# L4: MinIO 配置
# ---------------------------------------------------------------------------
MINIO_HOST=localhost
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=your-secure-password-here
MINIO_BUCKET_PREFIX=sisys
MINIO_SOX_RETENTION_DAYS=2555
MINIO_TEMP_RETENTION_DAYS=30
MINIO_MAX_CONNECTIONS=20
MINIO_SOCKET_TIMEOUT=30.0
MINIO_RETRY_ON_TIMEOUT=true

# ---------------------------------------------------------------------------
# L5: Neo4j 配置
# ---------------------------------------------------------------------------
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-secure-password-here
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECT_TIMEOUT=30.0
NEO4J_MAX_RETRY_TIME=30.0
NEO4J_PAGECACHE_SIZE=512m
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=1G
NEO4J_TX_STATE_MEMORY_MAX=256m

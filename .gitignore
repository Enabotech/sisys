# =============================================================================
# 例外规则 - 明确保留的重要文件
# =============================================================================

# 保留 .gitignore 自身
!.gitignore

# 保留示例和模板文件
!.env.example
!*.example
!*.template
!*.sample

# 保留必要的配置文件
!pyproject.toml
!poetry.lock
!Makefile
!*.yaml
!*.yml
!*.json
!*.toml

# 保留 VS Code 必要配置
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# 保留 GitHub Actions 工作流
!.github/workflows/*.yml
!.github/workflows/*.yaml

# 保留 Docker 配置
!docker/*.yml
!docker/*.sh
!docker/Dockerfile*

# 保留文档
!*.md
!docs/**/*

# 保留源代码
!src/**/*.py
!tests/**/*.py
!scripts/**/*.py

# 保留配置
!configs/**/*.yaml
!configs/**/*.yml

# =============================================================================
# 结束
# =============================================================================
# 此 .gitignore 文件专为 sisys 项目定制
# 覆盖了 Python 全栈开发、AI/ML、Docker、Kubernetes 等场景
# 定期审查和更新以适应项目需求变化
# =============================================================================

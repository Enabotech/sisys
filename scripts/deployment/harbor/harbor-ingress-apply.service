[Unit]
Description=Apply Harbor Ingress after K3s starts
Documentation=https://goharbor.io/
After=k3s.service network-online.target
Wants=k3s.service
# 确保 K3s 完全启动
ConditionPathExists=/var/lib/rancher/k3s/agent/etc/containerd/config.toml

[Service]
Type=oneshot
# 等待 K3s 完全启动后应用 Ingress（减少等待时间）
ExecStart=/bin/bash -c 'sleep 10 && /mnt/g/ai/sisys/scripts/deployment/harbor/apply-ingress.sh'
User=root
WorkingDirectory=/mnt/g/ai/sisys
StandardOutput=journal
StandardError=journal
TimeoutStartSec=180
RemainAfterExit=no

# 环境变量
Environment="KUBECONFIG=/etc/rancher/k3s/k3s.yaml"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

[Install]
WantedBy=multi-user.target

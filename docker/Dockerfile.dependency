# Layer 2: 项目依赖镜像
# 基于 PyTorch 官方镜像 (Layer 1)，预装项目依赖
# 更新频率：每周日 18 点 + 依赖变更触发
# 保留策略：保留最近 5 个版本

# ===========================================================================
# 基础镜像 (Layer 1)
# ===========================================================================
ARG PYTORCH_IMAGE=harbor.sisys.local/sisys/pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel
FROM ${PYTORCH_IMAGE} AS base

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_CACHE_DIR='/tmp/poetry_cache'

# 设置 Python 和 Poetry 版本
ARG PYTHON_VERSION=3.11
ARG POETRY_VERSION=2.3.2

# 验证基础镜像
RUN python3 --version && \
    pip3 --version && \
    echo "CUDA 版本:" && \
    python3 -c "import torch; print(f'PyTorch: {torch.__version__}, CUDA: {torch.version.cuda}')"

# ===========================================================================
# 安装 Python 依赖
# ===========================================================================
# 注意：不安装 Node.js，由 Gitea Runner 提供

# 重新声明 ARG（FROM 后需要重新声明才能使用）
ARG POETRY_VERSION

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY pyproject.toml poetry.lock ./

# 安装 Poetry 并安装依赖
# 使用清华源加速 pip 安装（关键！避免超时）
# Poetry 2.x 需要安装 poetry-plugin-export 插件
# 注意：使用 poetry install --no-root 安装依赖，不安装项目本身
RUN pip3 install --no-cache-dir --break-system-packages \
    "poetry==${POETRY_VERSION}" \
    poetry-plugin-export && \
    pip3 config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    poetry install --only main --no-interaction --no-root && \
    rm -rf /root/.cache/pypoetry pyproject.toml poetry.lock

# ===========================================================================
# 清理和验证
# ===========================================================================

# 清理缓存
RUN rm -rf ${POETRY_CACHE_DIR}

# 验证安装
RUN python3 --version && poetry --version

# 设置入口点
ENTRYPOINT ["/bin/bash"]

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" || exit 1

# 镜像标签说明
LABEL org.opencontainers.image.title="SISYS Dependency Image" \
      org.opencontainers.image.description="Pre-built dependency image for SISYS project (Layer 2)" \
      org.opencontainers.image.vendor="SISYS" \
      sisys.image.type="dependency" \
      sisys.image.layer="2" \
      sisys.python.version="3.11" \
      sisys.poetry.version="2.3.2" \
      sisys.pytorch.version="2.7.1" \
      sisys.cuda.version="12.8"

# =========================================
# sisys - 开发环境基础镜像
# 基础镜像：Ubuntu 22.04 + Python 3.11.15 + Node.js + Poetry 2.3.2
# 加速源：清华大学开源软件镜像站
# =========================================

FROM ubuntu:22.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    PYTHON_VERSION=3.11.15 \
    POETRY_VERSION=2.3.2 \
    NODE_VERSION=20.x

# =========================================
# 1. 配置 apt 镜像源 (使用阿里云源，HTTPS 兼容性更好)
# =========================================
RUN cp /etc/apt/sources.list /etc/apt/sources.list.bak && \
    cat > /etc/apt/sources.list <<EOF
# 阿里云开源软件镜像站 - Ubuntu 22.04 (jammy)
deb http://mirrors.aliyun.com/ubuntu/ jammy main restricted universe multiverse
deb http://mirrors.aliyun.com/ubuntu/ jammy-updates main restricted universe multiverse
deb http://mirrors.aliyun.com/ubuntu/ jammy-backports main restricted universe multiverse
deb http://mirrors.aliyun.com/ubuntu/ jammy-security main restricted universe multiverse
EOF

# =========================================
# 2. 安装系统基础依赖
# =========================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 基础工具
    build-essential \
    curl \
    wget \
    git \
    vim \
    ca-certificates \
    gnupg \
    lsb-release \
    software-properties-common \
    # Python 编译依赖
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libxml2-dev \
    libxmlsec1-dev \
    libffi-dev \
    liblzma-dev \
    # 清理
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && rm -rf /var/cache/apt/archives/*

# =========================================
# 3. 安装 Python 3.11.15 (从源码编译)
# =========================================
WORKDIR /tmp
# 下载 Python 源码（使用清华源）
RUN curl -fsSL https://mirrors.tuna.tsinghua.edu.cn/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz \
    | tar xzf -

WORKDIR /tmp/Python-${PYTHON_VERSION}

# 编译安装 Python
RUN ./configure --enable-optimizations --with-ensurepip=install \
    && make -j$(nproc) \
    && make install \
    && ldconfig

# 清理 Python 源码
WORKDIR /tmp
RUN rm -rf /tmp/Python-${PYTHON_VERSION}

# 设置 Python 别名
RUN ln -sf /usr/local/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/local/bin/pip3.11 /usr/local/bin/pip \
    && python --version

# =========================================
# 4. 配置 pip 清华源（系统级配置）
# =========================================
RUN mkdir -p /etc/pip && \
    cat > /etc/pip.conf <<EOF
[global]
index-url = https://pypi.tuna.tsinghua.edu.cn/simple
trusted-host = pypi.tuna.tsinghua.edu.cn
EOF

# =========================================
# 5. 安装 Node.js 20.x (使用 NodeSource)
# =========================================
WORKDIR /tmp

# 添加 NodeSource 仓库并安装 Node.js (包含 npm)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update && apt-get install -y nodejs \
    && node --version \
    && npm --version \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# =========================================
# 6. 安装 Poetry 2.3.2 (使用清华源)
# =========================================
# 设置 Poetry 环境变量
ENV POETRY_HOME="/opt/poetry" \
    POETRY_VERSION=2.3.2 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1

# 配置 Poetry 使用清华源（系统级配置）
RUN mkdir -p /etc/pypoetry && \
    cat > /etc/pypoetry/config.toml <<EOF
[[tool.poetry.source]]
name = "tsinghua"
url = "https://pypi.tuna.tsinghua.edu.cn/simple/"
priority = "primary"
EOF

# 使用官方安装脚本安装 Poetry (使用 --version 指定版本)
RUN curl -sSL https://install.python-poetry.org | python3 - --version ${POETRY_VERSION}

# 将 Poetry 添加到 PATH
ENV PATH="$POETRY_HOME/bin:$PATH"

# 验证 Poetry 安装
RUN poetry --version

# =========================================
# 7. 创建应用用户和目录
# =========================================
RUN groupadd --gid 1000 sisys && \
    useradd --uid 1000 --gid sisys --shell /bin/bash --create-home sisys

# 创建应用目录
WORKDIR /app
RUN chown -R sisys:sisys /app

# 复制入口脚本
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh && \
    chown sisys:sisys /usr/local/bin/entrypoint.sh

# =========================================
# 8. 配置工作目录和环境
# =========================================
USER sisys

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH="/app/src"

# 切换回应用目录
WORKDIR /app

# =========================================
# 9. 健康检查
# =========================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python --version && poetry --version && node --version || exit 1

# =========================================
# 10. 镜像标签
# =========================================
LABEL org.opencontainers.image.source="https://github.com/sisys/sisys" \
      org.opencontainers.image.description="SISYS Development Environment - Ubuntu 22.04 + Python 3.11.15 + Node.js + Poetry 2.3.2" \
      org.opencontainers.image.licenses="Proprietary" \
      sisys.python.version="3.11.15" \
      sisys.nodejs.version="20.x" \
      sisys.poetry.version="2.3.2" \
      sisys.ubuntu.version="22.04" \
      sisys.mirror.provider="Tsinghua University"

# =========================================
# 11. 入口点和默认命令
# =========================================
# ENTRYPOINT 设计说明：
# - 开发模式：直接运行容器，进入交互式 bash
# - 应用模式：docker run image poetry run python src/main.py
# - CI/CD 模式：docker run image make test
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]

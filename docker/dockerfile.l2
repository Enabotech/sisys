# =========================================
# sisys - L2 镜像 / CI/CD 专用 Dockerfile
# 基础镜像：harbor.sisys.local/sisys/dependency:l1-latest
# 用途：Gitea CI Pipeline 预构建镜像（仅包含依赖，不包含源码）
# 包含：Trivy 安全扫描工具 v0.69.3
# =========================================

# =========================================
# Stage 1: 基础环境（继承依赖镜像）
# =========================================
FROM harbor.sisys.local/sisys/dependency:l1-latest AS base

# CI/CD 环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_NO_INTERACTION=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_RETRIES=3 \
    PIP_DEFAULT_TIMEOUT=600 \
    CI=true \
    APP_HOME=/app \
    APP_USER=sisys \
    TRIVY_VERSION=0.69.3

WORKDIR ${APP_HOME}

# =========================================
# Stage 2: 安装项目依赖（分层缓存优化）
# =========================================
FROM base AS dependencies

# 仅复制依赖配置文件（最大化利用 Docker 层缓存）
COPY pyproject.toml poetry.lock ./

# 分层安装依赖（按组分离，优化缓存）
RUN poetry install --only main --no-root --no-interaction && \
    poetry install --with dev --no-root --no-interaction && \
    poetry install --with test --no-root --no-interaction

# =========================================
# Stage 3: CI 环境（仅包含依赖，不包含源码）
# =========================================
FROM base AS ci

USER root

# 从 dependencies 阶段复制虚拟环境
COPY --from=dependencies ${APP_HOME}/.venv ${APP_HOME}/.venv

# 复制项目配置文件（用于 poetry run 命令）
COPY --chown=${APP_USER}:${APP_USER} pyproject.toml poetry.lock ./

# 预创建报告目录（便于 CI 报告持久化）
RUN mkdir -p reports/coverage reports/pytest reports/linting reports/security && \
    chown -R ${APP_USER}:${APP_USER} ${APP_HOME}

# 安装 Trivy 安全扫描工具 (从本地 Harbor 仓库)
RUN set -eux; \
    # 下载 Trivy deb 包 (使用本地 Harbor 仓库，跳过证书验证)
    wget --no-check-certificate \
      https://gitea.sisys.local/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.deb \
        -O /tmp/trivy.deb; \
    # 安装 Trivy
    dpkg -i /tmp/trivy.deb; \
    # 清理下载文件
    rm -f /tmp/trivy.deb; \
    # 验证 Trivy 安装
    trivy --version; \
    # 配置 Trivy 缓存目录
    mkdir -p /root/.cache/trivy; \
    chown -R ${APP_USER}:${APP_USER} /root/.cache/trivy

USER ${APP_USER}

# 激活虚拟环境
ENV VIRTUAL_ENV="${APP_HOME}/.venv" \
    PATH="${APP_HOME}/.venv/bin:${PATH}" \
    PYTHONPATH="${APP_HOME}/src:${PYTHONPATH}" \
    PYTEST_ADDOPTS="--color=yes"

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD poetry run python -c "print('CI OK')" || exit 1

# 镜像标签
LABEL org.opencontainers.image.source="https://github.com/sisys/sisys" \
      org.opencontainers.image.description="SISYS CI/CD Environment - Dependencies only, source code mounted at runtime" \
      org.opencontainers.image.licenses="Proprietary" \
      sisys.image.type="ci" \
      sisys.python.version="3.11.15" \
      sisys.poetry.version="2.3.2" \
      sisys.trivy.version="0.69.3" \
      sisys.ci.version="1.0.0"

# 默认命令：运行所有测试（代码通过卷挂载提供）
CMD ["poetry", "run", "pytest", "tests/", "-v", "--tb=short"]

# =========================================
# Stage 4: 代码质量专用环境（可选）
# =========================================
FROM ci AS quality

USER root

# 质量检查入口脚本
COPY <<EOF /usr/local/bin/quality-check.sh
#!/bin/bash
set -e
echo "=== 代码质量检查 ==="
poetry run ruff check .
poetry run ruff format --check .
poetry run mypy src/ tests/
echo "=== 质量检查通过 ==="
EOF

RUN chmod +x /usr/local/bin/quality-check.sh

USER ${APP_USER}

CMD ["/usr/local/bin/quality-check.sh"]

# =========================================
# Stage 5: 安全扫描专用环境（可选）
# =========================================
FROM ci AS security

USER root

# 安全扫描入口脚本（使用 Trivy）
COPY <<EOF /usr/local/bin/security-scan.sh
#!/bin/bash
set -e
echo "=== 安全扫描 ==="
mkdir -p reports/security

# Python 代码安全扫描 (Bandit)
echo "🔍 运行 Bandit 代码安全扫描..."
poetry run bandit -r src/ -f json -o reports/security/bandit-report.json || true
poetry run bandit -r src/ -f screen -o reports/security/bandit-report.txt || true

# 依赖漏洞扫描 (Trivy)
echo "🔍 运行 Trivy 依赖漏洞扫描..."
trivy fs --format json --output reports/security/trivy-fs.json . || true
trivy fs --format table --output reports/security/trivy-fs.txt . || true

echo "=== 安全扫描完成 ==="
EOF

RUN chmod +x /usr/local/bin/security-scan.sh

USER ${APP_USER}

CMD ["/usr/local/bin/security-scan.sh"]

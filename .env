# sisys - Environment Variables Template
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ===========================================
# Application Settings
# ===========================================
APP_NAME=sisys
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.1

# ---------------------------------------------------------------------------
# 通用配置
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=sisys
HARBOR_REGISTRY=harbor.sisys.local

# ---------------------------------------------------------------------------
# L1: Redis 配置
# ---------------------------------------------------------------------------
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your-secure-password-here
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5.0
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=86400
REDIS_BLACKBOARD_TTL=604800

# ---------------------------------------------------------------------------
# L2: PostgreSQL 配置
# ---------------------------------------------------------------------------
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=sisys_dev
POSTGRES_DB=sisys
POSTGRES_DATABASE=sisys
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres  # pragma: allowlist secret
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30.0
POSTGRES_POOL_RECYCLE=3600
POSTGRES_ECHO=false
# POSTGRES_APP_PASSWORD=strong-app-password
# POSTGRES_READER_PASSWORD=strong-reader-password

# ---------------------------------------------------------------------------
# L3: Qdrant 配置
# ---------------------------------------------------------------------------
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
# QDRANT_API_KEY=your-secure-api-key-here
QDRANT_HTTPS=false
QDRANT_TIMEOUT=30.0
QDRANT_MAX_RETRIES=3
QDRANT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# L4: MinIO 配置
# ---------------------------------------------------------------------------
MINIO_HOST=host.docker.internal
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=your-secure-password-here
MINIO_BUCKET_PREFIX=sisys
MINIO_SOX_RETENTION_DAYS=2555
MINIO_TEMP_RETENTION_DAYS=30
MINIO_MAX_CONNECTIONS=20
MINIO_SOCKET_TIMEOUT=30.0
MINIO_RETRY_ON_TIMEOUT=true

# ---------------------------------------------------------------------------
# L5: Neo4j 配置
# ---------------------------------------------------------------------------
NEO4J_HOST=host.docker.internal
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123  # pragma: allowlist secret
NEO4J_MAX_POOL_SIZE=50
NEO4J_CONNECT_TIMEOUT=30.0
NEO4J_MAX_RETRY_TIME=30.0
NEO4J_PAGECACHE_SIZE=512m
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=1G
NEO4J_TX_STATE_MEMORY_MAX=256m

# ===========================================
# Security & Authentication
# ===========================================
SECRET_KEY=your_super_secret_key_for_jwt_signing_change_in_production  # pragma: allowlist secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# LLM & AI Settings
# ===========================================
# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:7b

# Cloud LLM (Optional - for fallback)
CLOUD_LLM_PROVIDER=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ===========================================
# Message Queue - RabbitMQ
# ===========================================
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest  # pragma: allowlist secret
RABBITMQ_VHOST=/

# ===========================================
# Monitoring & Observability
# ===========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# ===========================================
# Feature Flags
# ===========================================
ENABLE_SEMANTIC_CACHE=true
ENABLE_UDMR=true
ENABLE_EIP=true
ENABLE_CHECKPOINT=true

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================================
# File Upload Limits
# ===========================================
MAX_UPLOAD_SIZE_MB=2048
ALLOWED_FILE_EXTENSIONS=pdf,txt,doc,docx,ppt,pptx,xls,xlsx,csv,jpeg,png,gif,md,html,zip,tar

# ===========================================
# Config Sisys-runner Resource Limits
# ===========================================
RUNNER_TOOL_CACHE=X:\sisys-runner\_toolcache
RUNNER_TEMP=X:\sisys-runner\_temp
